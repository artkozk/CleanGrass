[Unit]
Description=CleanGrass Telegram bot
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/cleangrass
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONHASHSEED=random
ExecStart=/opt/cleangrass/.venv/bin/python /opt/cleangrass/main.py
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGINT
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/opt/cleangrass

[Install]
WantedBy=multi-user.target
